{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pyupvlgdtcxgqjungiof.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "studiolanave",
      "version": "0.1.0",
      "title": "studiolanave"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "Listar servicios y precios",
        "description": "Lista los servicios activos de Nave Studio (criomedicina, yoga, breathwork) con precio en CLP, duración y capacidad máxima.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_weekly_schedule",
        "title": "Horario semanal",
        "description": "Horario semanal recurrente publicado en /horarios: día, hora de inicio, clase e instructor. Opcionalmente filtra por día de la semana (0=Domingo).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "day_of_week": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6,
              "description": "Filtro opcional de día de la semana, 0=Domingo … 6=Sábado."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_available_slots",
        "title": "Cupos disponibles",
        "description": "Lista los horarios reservables con cupo disponible en un rango de fechas (máx. 30 días), con clase, instructor y cupos restantes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date_from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fecha inicial YYYY-MM-DD."
            },
            "date_to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fecha final YYYY-MM-DD (inclusive)."
            },
            "service_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filtro opcional por servicio."
            }
          },
          "required": [
            "date_from",
            "date_to"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_bookings",
        "title": "Listar reservas",
        "description": "Lista reservas en un rango de fechas con cliente, clase, estado y monto pagado. Solo devuelve datos si la cuenta conectada tiene permisos de administrador.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date_from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fecha inicial YYYY-MM-DD."
            },
            "date_to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fecha final YYYY-MM-DD (inclusive)."
            },
            "status": {
              "type": "string",
              "description": "Filtro opcional de estado, por ejemplo 'confirmed' o 'cancelled'."
            }
          },
          "required": [
            "date_from",
            "date_to"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_customers",
        "title": "Buscar clientes",
        "description": "Busca clientes del CRM por nombre, email o teléfono. Solo devuelve datos si la cuenta conectada tiene permisos de administrador.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Texto a buscar en nombre, email o teléfono."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Máximo de resultados (por defecto 10)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_studio_info",
        "title": "Información del estudio",
        "description": "Devuelve la base de conocimiento de Nave Studio (metodología, planes, membresías, reglas, ubicación). Opcionalmente filtra por categoría.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Categoría opcional, por ejemplo 'planes' o 'reglas'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
